# Maintainer: Kostiantyn Nedbailo <ChessPlayerSedoy@gmail.com>
pkgname=duop
pkgver=2.11.0
pkgrel=1
pkgdesc="Ultra-fast zero-libc dual-pane TUI file manager (static ~250 KB ELF, C23 + assembly PAL)"
arch=('x86_64' 'aarch64')
url="https://github.com/BlackKostia/duop"
license=('MIT')
makedepends=('binutils' 'make' 'python')
makedepends_x86_64=('gcc>=13')
makedepends_aarch64=('clang')
options=('!buildflags' '!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
# Run `updpkgsums` once the v$pkgver tag is published on GitHub
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  if [[ $CARCH == aarch64 ]]; then
    make release ARCH=aarch64 AS=as LD=ld   # native toolchain, not the aarch64-linux-gnu- cross names
  else
    make release ARCH=x86_64
  fi
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 duop "$pkgdir/usr/bin/duop"
  install -Dm755 scripts/duop-cd.sh "$pkgdir/usr/share/duop/duop-cd.sh"
  install -Dm644 -t "$pkgdir/usr/share/duop/layouts" layouts/*.layout
  install -Dm644 -t "$pkgdir/usr/share/duop/lang" lang/*.lang
  install -Dm644 -t "$pkgdir/usr/share/doc/duop" README.md docs/USER_GUIDE.md docs/HOTKEYS.md
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
